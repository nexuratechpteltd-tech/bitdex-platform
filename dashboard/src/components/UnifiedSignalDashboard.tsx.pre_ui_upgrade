        });
        const data = await res.json();
        if (res.ok) {
          setConnMessage(`Successfully updated profile '${newConn.label}'.`);
          setEditingProfileId(null);
          resetConnForm();
          await fetchConnections();
        } else {
          setConnMessage(data.detail || "Failed to update profile.");

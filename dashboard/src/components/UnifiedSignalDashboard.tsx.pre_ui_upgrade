                    </div>
                  </div>

                  <div className="p-3 rounded-lg bg-amber-950/30 border border-amber-500/30 text-amber-300/90 text-[11px] leading-relaxed flex items-start gap-2">
                    <AlertTriangle className="w-4 h-4 text-amber-400 shrink-0 mt-0.5" />
                    <span>
                      Advisory-only guidance. Risk parameters will NOT be updated without your explicit authorization.
                    </span>
                  </div>
                </div>
              ) : (
                <div className="text-slate-500 py-6 text-center">No advisory available for this position.</div>
              )}
            </div>

            <div className="p-4 border-t border-slate-800 bg-slate-950 flex items-center justify-between">
              <button
                onClick={() => {
                  setSelectedPositionForAdvisory(null);
                  setAiAdvisoryData(null);
                }}
                className="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono cursor-pointer transition-colors"
              >
                Close
              </button>

              {aiAdvisoryData && (
                <button
                  onClick={handleApplyAiAdvisoryTpSl}
                  className="px-4 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white text-xs font-mono font-bold flex items-center gap-1.5 cursor-pointer shadow-md shadow-violet-950/30"
                >
                  <ShieldCheck className="w-3.5 h-3.5" />
                  <span>Apply Recommended TP/SL</span>
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {/* ─── Modal 4: Adjust TP/SL Limits with Explicit Confirmation ─── */}
      {selectedPositionForTpSl && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md animate-in fade-in">
          <div className="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div className="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
              <div className="flex items-center gap-2.5">
                <div className="p-2 rounded-xl bg-cyan-950/60 border border-cyan-500/30 text-cyan-400">
                  <Sliders className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-base font-bold text-white font-mono">
                    Adjust Protective Limits
                  </h3>
                  <p className="text-xs text-slate-400">
                    {selectedPositionForTpSl.symbol} ({selectedPositionForTpSl.side})
                  </p>
                </div>
              </div>
              <button
                onClick={() => setSelectedPositionForTpSl(null)}
                className="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleSubmitTpSlAdjustment} className="p-6 space-y-4 text-xs font-mono">
              <div>
                <label className="block text-slate-400 text-[11px] mb-1">Take-Profit Target ($)</label>
                <input
                  type="number"
                  step="any"
                  placeholder="e.g. 72000"
                  value={tpSlForm.takeProfit}
                  onChange={(e) => setTpSlForm({ ...tpSlForm, takeProfit: e.target.value })}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                />
              </div>

              <div>
                <label className="block text-slate-400 text-[11px] mb-1">Stop-Loss Target ($)</label>
                <input
                  type="number"
                  step="any"
                  placeholder="e.g. 66000"
                  value={tpSlForm.stopLoss}
                  onChange={(e) => setTpSlForm({ ...tpSlForm, stopLoss: e.target.value })}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                />
              </div>

              {/* Explicit Confirmation Checkbox */}
              <div className="p-3 rounded-lg bg-slate-950 border border-slate-800 space-y-2">
                <label className="flex items-start gap-2.5 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={tpSlForm.confirmed}
                    onChange={(e) => setTpSlForm({ ...tpSlForm, confirmed: e.target.checked })}
                    className="mt-0.5 rounded border-slate-700 bg-slate-900 text-cyan-500 focus:ring-cyan-500 cursor-pointer"
                  />
                  <span className="text-slate-300 text-[11px] leading-relaxed">
                    I explicitly confirm modifying the protective exit parameters on this active position.
                  </span>
                </label>
              </div>

              <div className="pt-2 flex items-center justify-between">
                <button
                  type="button"
                  onClick={() => setSelectedPositionForTpSl(null)}
                  className="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono cursor-pointer transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={!tpSlForm.confirmed}
                  className="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-mono font-bold cursor-pointer transition-all shadow-md shadow-cyan-950/30"
                >
                  Commit TP/SL Update
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* ─── Modal 5: Position Execution & Fills History ─── */}
      {selectedPositionForHistory && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md animate-in fade-in">
          <div className="w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div className="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
              <div className="flex items-center gap-2.5">
                <div className="p-2 rounded-xl bg-cyan-950/60 border border-cyan-500/30 text-cyan-400">
                  <Receipt className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-base font-bold text-white font-mono">
                    Execution & Reconciliation History
                  </h3>
                  <p className="text-xs text-slate-400">
                    {selectedPositionForHistory.symbol} · {selectedPositionForHistory.position_id}
                  </p>
                </div>
              </div>
              <button
                onClick={() => setSelectedPositionForHistory(null)}
                className="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="p-6 overflow-y-auto space-y-4 flex-1 text-xs font-mono">
              <div className="overflow-x-auto rounded-xl border border-slate-800">
                <table className="w-full text-left font-mono">
                  <thead className="bg-slate-950 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                    <tr>
                      <th className="p-3">Fill ID</th>
                      <th className="p-3">Order ID</th>
                      <th className="p-3">Side</th>
                      <th className="p-3">Qty</th>
                      <th className="p-3">Price</th>
                      <th className="p-3">Fee</th>
                      <th className="p-3">Role</th>
                      <th className="p-3">Timestamp</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60 bg-slate-950/30">
                    {(selectedPositionForHistory.execution_history || []).map((f: any, idx: number) => (
                      <tr key={idx} className="hover:bg-slate-900/40 transition-colors">
                        <td className="p-3 text-cyan-400 font-bold">{f.fill_id || `--`}</td>
                        <td className="p-3 text-slate-400">{f.order_id || `--`}</td>
                        <td className="p-3">
                          <span className={f.side === "BUY" ? "text-emerald-400 font-bold" : "text-rose-400 font-bold"}>
                            {f.side}
                          </span>
                        </td>
                        <td className="p-3 text-slate-200">{f.qty}</td>
                        <td className="p-3 text-white font-bold">${f.price?.toLocaleString()}</td>
                        <td className="p-3 text-amber-300">${f.fee}</td>
                        <td className="p-3 text-slate-400">{f.role || "TAKER"}</td>
                        <td className="p-3 text-slate-500 text-[10px]">{f.timestamp || "--"}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="p-4 border-t border-slate-800 bg-slate-950 flex items-center justify-between">
              <span className="text-xs text-slate-500 font-mono">
                Total Fees Booked: ${selectedPositionForHistory.fees_paid.toFixed(4)}
              </span>
              <button
                onClick={() => setSelectedPositionForHistory(null)}
                className="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono cursor-pointer transition-colors"
              >
                Close History
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ─── Modal 6: New Paper Position Creation ─── */}
      {isCreatingPaperPosition && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md animate-in fade-in">
          <div className="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div className="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
              <div className="flex items-center gap-2.5">
                <div className="p-2 rounded-xl bg-cyan-950/60 border border-cyan-500/30 text-cyan-400">
                  <Zap className="w-5 h-5" />
                </div>
                <div>
                  <h3 className="text-base font-bold text-white font-mono">
                    Open New Paper Position
                  </h3>
                  <p className="text-xs text-slate-400">
                    Instant simulated paper trading execution
                  </p>
                </div>
              </div>
              <button
                onClick={() => setIsCreatingPaperPosition(false)}
                className="p-2 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleCreatePaperPosition} className="p-6 space-y-3.5 text-xs font-mono">
              <div>
                <label className="block text-slate-400 text-[11px] mb-1">Symbol</label>
                <input
                  type="text"
                  placeholder="e.g. BTCUSDT"
                  value={paperForm.symbol}
                  onChange={(e) => setPaperForm({ ...paperForm, symbol: e.target.value })}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                />
              </div>

              <div>
                <label className="block text-slate-400 text-[11px] mb-1">Side</label>
                <select
                  value={paperForm.side}
                  onChange={(e) => setPaperForm({ ...paperForm, side: e.target.value })}
                  className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                >
                  <option value="LONG">LONG (Buy Entry)</option>
                  <option value="SHORT">SHORT (Sell Entry)</option>
                </select>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-slate-400 text-[11px] mb-1">Size (units)</label>
                  <input
                    type="number"
                    step="any"
                    placeholder="0.05"
                    value={paperForm.size}
                    onChange={(e) => setPaperForm({ ...paperForm, size: e.target.value })}
                    className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                  />
                </div>

                <div>
                  <label className="block text-slate-400 text-[11px] mb-1">Entry Price ($)</label>
                  <input
                    type="number"
                    step="any"
                    placeholder="68500"
                    value={paperForm.entryPrice}
                    onChange={(e) => setPaperForm({ ...paperForm, entryPrice: e.target.value })}
                    className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-slate-400 text-[11px] mb-1">Stop-Loss ($)</label>
                  <input
                    type="number"
                    step="any"
                    placeholder="66500"
                    value={paperForm.stopLoss}
                    onChange={(e) => setPaperForm({ ...paperForm, stopLoss: e.target.value })}
                    className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                  />
                </div>

                <div>
                  <label className="block text-slate-400 text-[11px] mb-1">Take-Profit ($)</label>
                  <input
                    type="number"
                    step="any"
                    placeholder="72000"
                    value={paperForm.takeProfit}
                    onChange={(e) => setPaperForm({ ...paperForm, takeProfit: e.target.value })}
                    className="w-full px-3 py-2 rounded-lg bg-slate-950 border border-slate-800 text-white font-mono"
                  />
                </div>
              </div>

              <div className="pt-2 flex items-center justify-between">
                <button
                  type="button"
                  onClick={() => setIsCreatingPaperPosition(false)}
                  className="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-mono cursor-pointer transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  className="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-mono font-bold cursor-pointer transition-all shadow-md shadow-cyan-950/30"
                >
                  Create Position
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

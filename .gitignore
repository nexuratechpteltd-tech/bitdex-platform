# ==============================================================================
# BITDEX Platform — Institutional Security .gitignore
# Strictly excludes all database files, secrets, customer records, and build artifacts
# ==============================================================================

# --- Secrets & Environment Configurations ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt
*.p12
*.id_rsa
*.id_ed25519
*.secret

# --- Databases, WAL & Storage ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
data/*.db*
backend/data/*.db*
backend/*.db*
backups/

# --- Customer Data, Journals & Private Uploads ---
data/
uploads/
*.csv
*.tsv
*.xlsx
phase4_acceptance_raw_log.json

# --- Backups, Archives & Patches ---
*.tar.gz
*.tgz
*.zip
*.7z
*.bak*
*.backup*
*.old

# --- Python Virtual Environment & Bytecode ---
__pycache__/
*.py[cod]
*.class
*.so
.Python
**/.venv
venv/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# --- Node.js & Next.js Build Artifacts ---
**/node_modules
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo/
.vercel

# --- Screenshots & Media ---
evidence_screenshots/
*.png
*.jpg
*.jpeg
*.gif
*.svg.map

# --- OS & Editor Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Runtime logs and watchdog heartbeat
backend/watchdog.log
backend/watchdog_heartbeat.json
*.log
